# Niyati Browser Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# INDIAMART CREDENTIALS
# =============================================================================
INDIAMART_MOBILE=9033297351

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=7675005222:AAGbBMqpog1x-OBXD_32ZIgT2qdVOPgb8S4
TELEGRAM_CHAT_ID=7838498778


# =============================================================================
# DAILY REPORTS CONFIGURATION
# =============================================================================
# Timezone for daily reports (default: Asia/Kolkata)
DAILY_TZ=Asia/Kolkata

# Report times in HH:MM format, comma-separated (default: 08:00,20:00)
DAILY_REPORT_TIMES=08:00,20:00

# Catch-up window in minutes if app was offline (default: 120)
DAILY_CATCHUP_MINS=120

# =============================================================================
# LOCK SCREEN CONFIGURATION
# =============================================================================
# Show lock screen on startup (1=yes, 0=no) (default: 1)
LOCK_ON_START=1

# Persist unlock state across restarts (1=yes, 0=no) (default: 1)
LOCK_PERSIST=1

# Unlock state TTL in milliseconds (0=never expire) (default: 0)
LOCK_PERSIST_TTL_MS=0

# Lock screen password (recommended to set)
LOCK_PASSWORD=your_secure_password_here

# =============================================================================
# APPLICATION BEHAVIOR
# =============================================================================
# Disable console logging (1=quiet, 0=verbose) (default: 1)
QUIET=1

# Enable debug mode (1=yes, 0=no) (default: 0)
DEBUG=0

# Auto-start refresh on app startup (1=yes, 0=no) (default: 0)
AUTO_START_REFRESH=0

# Default refresh interval in seconds (default: 7)
DEFAULT_REFRESH_INTERVAL=7

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Memory cleanup interval in minutes (default: 60)
MEMORY_CLEANUP_INTERVAL=60

# Maximum log entries to keep in memory (default: 1000)
MAX_LOG_ENTRIES=1000

# Maximum products to track (default: 10000)
MAX_PRODUCTS=10000

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# Network probe timeout in milliseconds (default: 4000)
NETWORK_PROBE_TIMEOUT=4000

# Network retry delay in milliseconds (default: 5000)
NETWORK_RETRY_DELAY=5000

# Maximum network retry attempts (default: 3)
MAX_NETWORK_RETRIES=3

# =============================================================================
# AUTO-LOGIN CONFIGURATION
# =============================================================================
# Maximum login attempts (default: 3)
MAX_LOGIN_ATTEMPTS=3

# OTP resend cooldown in milliseconds (default: 30000)
OTP_RESEND_COOLDOWN=30000

# Login timeout in milliseconds (default: 300000 = 5 minutes)
LOGIN_TIMEOUT=300000

# =============================================================================
# FILE PATHS (Advanced)
# =============================================================================
# Custom reports directory (leave empty for default)
REPORTS_DIR=

# Custom logs directory (leave empty for default)
LOGS_DIR=

# Custom data directory (leave empty for default)
DATA_DIR=

# =============================================================================
# ADVANCED SETTINGS (Do not modify unless you know what you're doing)
# =============================================================================
# Electron command line switches (comma-separated)
# Example: disable-gpu,disable-software-rasterizer
ELECTRON_SWITCHES=

# Custom user agent
USER_AGENT=

# Proxy settings (format: http://host:port)
PROXY_SERVER=

# Maximum memory usage in MB before restart (0=disabled)
MAX_MEMORY_MB=0

# Auto-restart on crash (1=yes, 0=no) (default: 1)
AUTO_RESTART_ON_CRASH=1
